				<value>kbee.payment.MercadoPagoKbeePayment</value>



			</list>
			
		</property>	
	</bean>

	<bean id="sessionFactory" parent="sessionFactoryAbstract"
		class="org.springframework.orm.hibernate5.LocalSessionFactoryBean">
		<property name="annotatedClasses">
			<list merge="true">
				<value>com.novamens.kbee.dom.AbstractObject</value>
			</list>
		</property>
	</bean>
	
	<alias alias="entityManagerFactory" name="sessionFactory" />
	
	
	<bean id="txInterceptor" 
		class="org.springframework.transaction.interceptor.TransactionInterceptor">
			<property name="transactionManager" ref="transactionManager" />
			<property name="transactionAttributes">
				<props>
					<prop key="save">PROPAGATION_REQUIRED</prop>
				</props>
			</property>
	</bean>
	
	<bean id="transactionManager" class="org.springframework.orm.hibernate5.HibernateTransactionManager">
		<property name="sessionFactory">
			<ref bean="sessionFactory" />
		</property>
	</bean>
	
	<bean id="eventsInterceptor" class="com.novamens.kbee.interceptor.EventsInterceptor"/>
	
	<bean id="sitesPage" class="kbee.web.portal6.SitesPage" scope="prototype"></bean>
	
	<bean id="user-directory"   class="kbee.web.portal6.panel.DirectoryFavoritesHeaderPanel" scope="prototype"/>
	
	<bean id="user-myactivity" 	class="kbee.web.portal6.panel.MyActivityContextualMenu" scope="prototype"/>
	
	<bean id="ConvertMyBoxCommand" class="kbee.web.command.ConvertMyBoxCommand" />
	
	
	<!-- bean id="console-footer" class="com.novamens.wicket.util.DummyBlockPanel"  scope="prototype"/-->
	
	

</beans>