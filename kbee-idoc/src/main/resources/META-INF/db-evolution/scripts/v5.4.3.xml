    <changeSet author="grodriguez" id="liquibase_path_normalization">
        <sql><![CDATA[
             delete from databasechangelog log
                where exists(select 1 from databasechangelog log2
                where log.id = log2.id and log2.dateexecuted < log.dateexecuted
                );
            ]]>
        </sql>

        <sql><![CDATA[
                update databasechangelog
                set filename=REGEXP_REPLACE(filename,'.*db-evolution/(.*)','\1')
                where filename like '%db-evolution/%';
            ]]>
        </sql>
    </changeSet>


