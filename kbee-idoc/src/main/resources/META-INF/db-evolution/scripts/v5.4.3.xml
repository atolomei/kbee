    <changeSet author="grodriguez" id="pivot_content_template_alias">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="rs_windsor_activity_pivot"/>
            <not>
                <columnExists tableName="rs_windsor_activity_pivot" columnName="content_template_alias"/>
            </not>
        </preConditions>
        <addColumn tableName="rs_windsor_activity_pivot">
            <column name="content_template_alias" type="varchar(24)"></column>
        </addColumn>
        <sql><![CDATA[
            update rs_windsor_activity_pivot pv
            set content_template_alias =
                        (select kc.contentclasscode
                            from content con
                                inner join kb_contenttemplate kc on con.contenttemplate = kc.id where con.id = pv.content_id
                        )
             ]]>
        </sql>
    </changeSet>


    <changeSet author="grodriguez" id="pivot_windsor_submissiontime 1">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="rs_windsor_activity_pivot"/>
        	<not>
                <columnExists tableName="rs_windsor_activity_pivot" columnName="submissiontime"/>
            </not>
        </preConditions>
        
        <addColumn tableName="rs_windsor_activity_pivot">
            <column name="submissiontime" type="timestamp with time zone"/>
        </addColumn>

        <sql><![CDATA[
                update rs_windsor_activity_pivot pvt
                  set submissiontime = (select min(endtime) from
                                            rs_windsor_activity_pivot pvt2
                                            where pvt2.process = pvt.process and task = 'Submission')
            ]]>
        </sql>
    </changeSet>

    <changeSet author="grodriguez" id="pivot_windsor_update_type">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="rs_windsor_activity_pivot"/>
        </preConditions>
        <sql><![CDATA[
                    update rs_windsor_activity_pivot pvt
                        set type = (select min(ct.datasetmember_id) from
                                         classification CT, kb_classifier CL
                                           where CL.domain_id = (select id from domain
                                                                        where name = 'windsor') and CL.id=CT.classifier_id
                                                                                and (CL.alias = 'documenttype' or CL.alias = 'type')
                                                                                 and ct.content_id=pvt.content_id
                                                                )
                    where pvt.type is null;
            ]]>
        </sql>
    </changeSet>

