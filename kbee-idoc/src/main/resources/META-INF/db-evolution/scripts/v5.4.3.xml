    <changeSet author="aferraria" id="dataset_elements_template_create">
        <sql><![CDATA[
		create table if not exists kb_ds_element_template (
			id bigint not null,
			dataset_id bigint not null,
			position integer,
			classifier_id bigint,
			attribute_id bigint,
			multiplicity integer,
			readonly boolean,
			aggregation boolean,
			CONSTRAINT dse_template_pk PRIMARY KEY (id),
			CONSTRAINT dse_dataset_fk FOREIGN KEY (dataset_id) REFERENCES dataset(id),
			CONSTRAINT dse_classifier_fk FOREIGN KEY (classifier_id) REFERENCES kb_classifier(id),
			CONSTRAINT dse_attribute_fk FOREIGN KEY (attribute_id) REFERENCES kb_attribute(id)
		);

		delete from kb_ds_element_template;
		
		insert into kb_ds_element_template (id, dataset_id, position, classifier_id, multiplicity, readonly, aggregation)
		select 
		nextval('domainid_sequence'),dataset_id, currval('domainid_sequence'), classifier_id,  1, false, false 
		from 
		datasetclassifier;
	
		insert into kb_ds_element_template (id, dataset_id, position, attribute_id, multiplicity, readonly, aggregation)
		select 
		nextval('domainid_sequence'), a.dataset_id, currval('domainid_sequence'), t.attribute_id,  1, false, false
		from 
		kb_datasetattribute a, kb_attributetemplate t
		where
		a.attributetemplate_id = t.id;
		]]>
        </sql>
    </changeSet>


