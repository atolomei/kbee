<wicket:panel>
	<div class="row standard-canvas">
		<form wicket:id="form" class="form-container col-md-9 col-lg-9 col-xs-12" role="form">
				<div wicket:id="isapi" class="form-group alert alert-info" role="alert"> <wicket:message key="isapi" /></div>
				<div class="row panel">
					<div class="col-lg-12 col-xs-12 col-md-12 panel">
						<div class="row">
							<h2 class="col-lg-12 col-xs-12 col-md-12"><wicket:message key="structure"/></h2>
							<div class="col-xs-12 col-lg-12 col-md-12 form-group" wicket:id="name"/>
							<div class="col-xs-12 col-lg-12 col-md-12 form-group" wicket:id="dataSet"/>
							<div class="col-xs-12 col-lg-12 col-md-12 form-group" wicket:id="multiplicity"/>
							<div class="col-xs-12 col-lg-12 col-md-12 form-group" wicket:id="alias"/>
							<div class="col-xs-12 col-lg-12 col-md-12 form-group" wicket:id="description"/>
						</div>	
					</div>
					
					<div class="col-lg-12 col-xs-12 col-md-12 panel">
						<div class="row">
							<h2 class="col-lg-12 col-xs-12 col-md-12">Include in new Content Templates</h2>
							<div class="col-xs-12 col-lg-12 col-md-12 form-group" wicket:id="isDefaultStructure"/>
						</div>
					</div>
					
					<div class="col-lg-12 col-xs-12 col-md-12 panel">
						<div class="row">
							<h2 class="col-lg-12 col-xs-12 col-md-12">Semantics</h2>
							<div class="col-xs-12 col-lg-12 col-md-12 form-group" wicket:id="isContentType"/>
						</div>
					</div>
					
					<div class="col-lg-12 col-xs-12 col-md-12 panel">
						<div class="row">
							<h2 class="col-lg-12 col-xs-12 col-md-12"><wicket:message key="access"/></h2>
							<div class="col-xs-12 col-lg-12 col-md-12 form-group" wicket:id="isSearchable"/>
						</div>	
					</div>

					<div class="col-lg-12 col-xs-12 col-md-6 panel">
						<div class="row">
							<h2 class="col-lg-12 col-xs-12 col-md-12"><wicket:message key="iql"/></h2>
							<div class="col-xs-12 col-lg-12 col-md-12 form-group" wicket:id="isRuleCondition"/>
							<div class="col-xs-12 col-lg-12 col-md-12 form-group" wicket:id="predicate"/>
						</div>	
					</div>
							
					<div class="col-lg-12 col-xs-12 col-md-6 panel">
						<div class="row">
							<h2 class="col-lg-12 col-xs-12 col-md-12"><wicket:message key="display"/></h2>
							<div class="col-xs-12 col-lg-12 col-md-12 form-group" wicket:id="isPortal"/>
						</div>
					</div>
					
					<!-- >div class="col-lg-12 col-xs-12 col-md-6 panel">
						<div class="row">
							<h2 class="col-lg-12 col-xs-12 col-md-12"><wicket:message key="semantic"/></h2-->
							<!--  --div class="col-xs-12 col-lg-12 col-md-12 form-group" wicket:id="isSemantic"/ -->
							<!-- div class="col-xs-12 col-lg-12 col-md-12 form-group" wicket:id="predicate"/-->
						<!-- /div>
					</div -->
				</div>						
		</form>
		<div class="button-container col-md-3 col-xs-12 col-lg-3" wicket:id="buttons"/>
	</div>
	
	<div wicket:id="help-modal" class="modal window" z-index=999999 tabindex="-6" role="dialog"/>
</wicket:panel>