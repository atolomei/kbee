<wicket:panel>

	<div class="container" style="margin-bottom: 64px; max-width: 902px;">
		<div class="content-header">
			<div class="title-container">
				<div class="icon-container">
					<i class="far fa-user"></i>
				</div>
				<div style="margin-top: 0px; width: initial; float: left;">
					<h1>
						<wicket:message key="newuser" />
					</h1>
					<div wicket:id="breadcrumb"></div>
				</div>
			</div>
		</div>

		<div class="row">
			<form wicket:id="form" class="col-md-12 col-lg-12 col-xs-12 "
				role="form" style="margin: 0;">
				<fieldset style="margin-bottom: 12px;">
					<div class="row">
						<h2 class="col-lg-12 ">
							<wicket:message key="account" />
						</h2>
						
						<div wicket:id="user-clone-alert" class="col-lg-12 col-xs-12 col-md-12">
								<span class="alert alert-info"> <span wicket:id="clone" /></span>
						</div>
						
						<div class="col-xs-12 col-md-6 col-lg-6 form-group"			wicket:id="firstName" />
						<div class="col-xs-12 col-md-6 col-lg-6 form-group"			wicket:id="lastName" />
						<div class="col-xs-12 col-md-12 col-lg-12 form-group"		wicket:id="userName" />
						<div class="col-xs-12 col-md-12 col-lg-12 form-group"		wicket:id="startpage" />
						<div class="col-xs-12 col-md-12 col-lg-12 form-group"	wicket:id="email" />
						<div class="col-xs-12 col-md-12 col-lg-12 form-group"	wicket:id="resetPassword" />
						<div class="col-xs-12 col-md-12 col-lg-12 form-group"	wicket:id="clone-user-roles" />
					</div>

					<div class="row">
						<!-- h2 class="col-lg-12 "><wicket:message key="general-permissions" /></h2-->
						<!-- div class="col-lg-12 col-xs-12 col-md-12">			
						<div class="alert alert-info"><wicket:message key="general-permissions-info" /></div>
						</div-->
						<!-- div class="col-xs-12 col-lg-6 col-md-6 form-group" wicket:id="my_tasks"/>
						<div class="col-xs-12 col-lg-6 col-md-6 form-group" wicket:id="auditor"/>
						<div class="col-xs-12 col-lg-6 col-md-6 form-group" wicket:id="content_base"/ -->
						<!--  div class="col-xs-12 col-lg-6 col-md-6 form-group" wicket:id="templates"/  -->
						<!-- div class="col-xs-12 col-lg-6 col-md-6 form-group" wicket:id="information_model"/ -->
						<!-- div class="col-xs-12 col-lg-12 col-md-6 form-group" wicket:id="domain_admin"/-->
						<!-- div class="col-xs-12 col-lg-6 col-md-6 form-group" wicket:id="security"/>
						<div class="col-xs-12 col-lg-6 col-md-6 form-group" wicket:id="datasets_elements_read"/>
						<div class="col-xs-12 col-lg-6 col-md-6 form-group" wicket:id="archive"/>
						</div -->
						<div class="col-lg-12  form-group" wicket:id="groups" />
					</div>
					
				</fieldset>
				
				<div wicket:id="defaultpassword-container" class="alert alert-info" style="margin-top: -10px; clear:left; float:left; width:100%; margin-bottom: 30px;" role="alert">
						<span style="clear:left; float:left;" wicket:id="defaultpassword"></span>
				</div>											
				
			</form>
		</div>

		<div class="row">
			<div class="col-md-12 col-lg-10 col-xs-12" wicket:id="buttons" />
		</div>

		<div class="row">
			<div class="col-md-12 col-lg-12 col-xs-12" wicket:id="feedback-container">
				<div class="alert alert-success" style="clear:left; float:left; width:100%;" role="alert">
					<span style="clear:left; float:left;"><wicket:message key="newuser.message.sucess" /> </span>
					<span style="clear:left; float:left;" wicket:id= "new-user-info" ></span>
				</div>

				<div class="row">
					<div class="col-lg-12 col-xs-12 col-md-12">
						<div class="row">
							<h2 class="col-lg-12 col-xs-12 col-md-12"
								style="margin-top: 24px; margin-bottom: 18px;">
								<wicket:message key="newuser.action.label" />
							</h2>
						</div>
						<div class="row">
							<div class="col-lg-12 col-xs-12 col-md-12" style="margin-bottom: 40px;">
								
								<!-- div style="width: auto;">
									<a class="btn btn-link "
										style="margin: 3px 0; padding-left: 0;"
										wicket:id="createrule-link" target="_blank"><wicket:message
											key="newuser.createrule" /></a>
								</div-->
								
								<div style="width: auto;">
									<a class="btn btn-link" style="margin: 3px 0; padding-left: 0;"
										wicket:id="edit-link" target="_blank"><wicket:message
											key="newuser.action.edit" /></a>
								</div>
								
								<div style="width: auto;">
									<a class="btn btn-default btn-sm"
										style="margin-top: 15px; margin-left: 0px; width: 220px;"
										wicket:id="create-link"><wicket:message
											key="newuser.action.create" /></a>
								</div>
							</div>
						</div>
					</div>

				</div>
			</div>
		</div>
	</div>


</wicket:panel>