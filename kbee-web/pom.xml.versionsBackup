	<modelVersion>4.0.0</modelVersion>

	<artifactId>kbee-web</artifactId>
	<name>${project.artifactId}</name>
	<version>6.1-SNAPSHOT</version>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>

	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<includes>
					<include>**/*.*</include>
				</includes>
			</resource>
		</resources>
	</build>

	<description>Front end library for Content Management applications. It uses Wicket services provided by novamens-consoles and kbee-wfc-wicket to implement content management services on the novamens-content and kbee-content API</description>
