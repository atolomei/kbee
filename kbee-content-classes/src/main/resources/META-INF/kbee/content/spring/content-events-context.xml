	<bean id="SocialEventListener" 					class="kbee.web.listener.SocialEventListener"/>
	<bean id="KnowledgeSharingEventListener" 		class="kbee.web.listener.KnowledgeSharingEventListener"/>
	-->
	
	<bean id="MemberUpdateListener" class="com.novamens.kbee.content.event.MemberUpdateListener"/>
	
	<bean id="AnswerUpdateListener"	class="com.novamens.kbee.content.questionanswer.AnswerUpdateListener"/>
	
	<bean id="QuestiontUpdateListener" 	class="com.novamens.kbee.content.questionanswer.QuestionUpdateListener">
